#include <Wire.h>
#include <Adafruit_INA3221.h>

// ------------------------
// INA3221
// ------------------------
Adafruit_INA3221 ina;

const float SHUNT_RESISTOR = 0.02;
const int INA_CHANNEL = 1;

// ------------------------
// Battery voltage
// ------------------------
#define BATTERY_PIN A0

const float R1 = 10000.0;
const float R2 = 10000.0;
const float VREF = 4.98;

// ------------------------
// Discharge control
// ------------------------
const int PWM_PIN = 5;

const float TARGET_CURRENT = 5.0;
const float VOLTAGE_CUTOFF = 0.9;

const float Kp = 20.0;

bool autoControl = false;

int pwmValue = 0;
int state = 0;

// 0 idle
// 1 discharge
// 2 finished
// 3 pause

const int CUTOFF_COUNT = 5;
int cutoffCounter = 0;

unsigned long startTime = 0;

// ------------------------
// battery voltage read
// ------------------------
float readBatteryVoltage()
{
  long sum = 0;

  for(int i=0;i<10;i++)
  {
    sum += analogRead(BATTERY_PIN);
  }

  float adc = sum / 10.0;

  float voltage =
  (adc / 1023.0) * VREF * (R1 + R2) / R2;

  return voltage;
}

// ------------------------
// setup
// ------------------------
void setup()
{
  Serial.begin(115200);

  pinMode(PWM_PIN, OUTPUT);

  Wire.begin();

  if (!ina.begin())
  {
    Serial.println("INA3221 NOT FOUND");
    while(1);
  }

  Serial.println("READY");
}

// ------------------------
// loop
// ------------------------
void loop()
{
  unsigned long now = millis();
  unsigned long elapsed = (now - startTime) / 1000;

  float batteryVoltage = readBatteryVoltage();

  float shuntVoltage =
  ina.getShuntVoltage_mV(INA_CHANNEL) / 1000.0;

  float current =
  shuntVoltage / SHUNT_RESISTOR;

  float power =
  batteryVoltage * current;

  // ------------------------
  // serial command
  // ------------------------
  if (Serial.available())
  {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd == "START")
    {
      autoControl = true;
      state = 1;

      pwmValue = 0;
      cutoffCounter = 0;
      startTime = millis();

      Serial.println("ACK,START");
    }

    if (cmd == "STOP")
    {
      autoControl = false;
      pwmValue = 0;
      state = 0;

      Serial.println("ACK,STOP");
    }

    if (cmd == "PAUSE")
    {
      state = 3;
      pwmValue = 0;

      Serial.println("ACK,PAUSE");
    }

    if (cmd == "RESUME")
    {
      state = 1;

      Serial.println("ACK,RESUME");
    }
  }

  // ------------------------
  // discharge control
  // ------------------------
  if (autoControl && state == 1)
  {
    if (batteryVoltage > VOLTAGE_CUTOFF)
    {
      cutoffCounter = 0;

      float error =
      TARGET_CURRENT - current;

      pwmValue += (int)(Kp * error * 0.2);

      if (pwmValue > 255) pwmValue = 255;
      if (pwmValue < 0) pwmValue = 0;
    }
    else
    {
      cutoffCounter++;

      if (cutoffCounter >= CUTOFF_COUNT)
      {
        pwmValue = 0;
        state = 2;
      }
    }
  }

  analogWrite(PWM_PIN, pwmValue);

  // ------------------------
  // DATA OUTPUT
  // ------------------------
  Serial.print("DATA,");
  Serial.print(elapsed);
  Serial.print(",");
  Serial.print(batteryVoltage, 3);
  Serial.print(",");
  Serial.print(current, 3);
  Serial.print(",");
  Serial.print(power, 3);
  Serial.print(",");
  Serial.print(pwmValue);
  Serial.print(",");
  Serial.println(state);

  delay(200);
}


